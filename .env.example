# NL2SQL 模型生成超时；慢模型演示可将 TASK_DEADLINE_SECONDS 调至 120
SQL_MODEL_TIMEOUT_SECONDS=60
# Qwen 混合思考模型配合强制结构化输出时关闭思考；其他端点可留空不传。
CHAT_ENABLE_THINKING=false
# 模型传输超时；连接失败仅在任务预算内重试一次，不重放业务工具。
CHAT_TRANSPORT_TIMEOUT_SECONDS=30

# 可恢复的咨询建议确认（不替代售后申请提交与系统审核）
AGENT_HUMAN_APPROVAL=false
# 本地普通 Redis 不支持检查点所需模块，推荐复用 PostgreSQL。
# memory 仅限单进程开发；redis 需 Redis Stack；auto 失败时回退内存。
CHECKPOINT_BACKEND=postgres
# 仅 Redis 后端支持此 TTL；PostgreSQL 检查点需单独安排清理。
CHECKPOINT_TTL_MINUTES=43200
